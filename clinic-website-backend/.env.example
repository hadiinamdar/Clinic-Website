# Copy this file to ".env" (same folder) and edit. Never share or commit ".env".

# --- REQUIRED for the staff dashboard at /admin ---------------------------
# Choose a long, unique password. Leave empty and /admin stays switched off.
ADMIN_PASSWORD=123456

# --- General ---------------------------------------------------------------
# "production" hides the /docs pages. Use it on the live server.
APP_ENV=development
# Browsers allowed to call the API from another website. "*" = any (fine when the
# backend serves the website itself). In production use e.g. https://yourclinic.com
CORS_ORIGINS=*
# Set true ONLY if exactly one reverse proxy (nginx/Caddy) sits in front.
TRUST_PROXY=false
# How long a staff login lasts, in minutes.
ADMIN_SESSION_MINUTES=480

# --- Booking rules ---------------------------------------------------------
BOOKING_LEAD_MINUTES=30
BOOKING_MAX_DAYS_AHEAD=60
MAX_ACTIVE_PER_PHONE=3

# --- E-mail notifications (optional) ----------------------------------------
# Leave SMTP_HOST empty to send no e-mail. Gmail example: smtp.gmail.com, port 587,
# user = full address, password = a Google "App password".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Where new-booking alerts go (default: karediagnosticslab@gmail.com)
NOTIFY_EMAIL=
